#!/bin/sh
set -eu

emit_error() {
  error_code="$1"
  message="$2"
  exit_code="$3"
  printf '%s\n' "{\"schema\":\"dev.safa.cli/v1\",\"command\":\"launcher\",\"status\":\"failed\",\"request_id\":null,\"data\":{\"error\":{\"code\":\"${error_code}\",\"message\":\"${message}\",\"retryable\":false}},\"warnings\":[],\"next_action\":null}"
  exit "$exit_code"
}

if [ "$(uname -s)" != "Darwin" ]; then
  emit_error "unsupported_platform" "SAFA requires macOS." 45
fi

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
app_path="${script_dir}/../assets/SAFA.app"
cli_path="${app_path}/Contents/Helpers/safa"

if [ ! -x "$cli_path" ]; then
  printf '%s\n' '{"schema":"dev.safa.cli/v1","command":"launcher","status":"user_action_required","request_id":null,"data":{"error":{"code":"runtime_missing","message":"The signed SAFA companion runtime has not been assembled in this development Skill.","retryable":false}},"warnings":[],"next_action":{"kind":"install_verified_runtime","safe_for_agent":false}}'
  exit 22
fi

if ! /usr/bin/codesign --verify --deep --strict "$app_path" >/dev/null 2>&1; then
  emit_error "runtime_signature_invalid" "The bundled SAFA runtime failed code-signature verification." 45
fi

exec "$cli_path" "$@"
