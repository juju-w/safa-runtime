#!/bin/sh
set -eu

emit_error() {
  error_code="$1"
  message="$2"
  exit_code="$3"
  printf '%s\n' "{\"schema\":\"dev.safa.cli/v1\",\"command\":\"launcher\",\"status\":\"failed\",\"request_id\":null,\"data\":{\"error\":{\"code\":\"${error_code}\",\"message\":\"${message}\",\"retryable\":false}},\"warnings\":[],\"next_action\":null}"
  exit "$exit_code"
}

if [ "$(uname -s)" != "Darwin" ]; then
  emit_error "unsupported_platform" "SAFA requires macOS." 45
fi

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
runtime_path="${script_dir}/../assets/runtime"
cli_path="${runtime_path}/safa"
broker_path="${runtime_path}/safa-broker"
askpass_path="${runtime_path}/safa-askpass"

if [ ! -x "$cli_path" ] || [ ! -x "$broker_path" ] || [ ! -x "$askpass_path" ]; then
  printf '%s\n' '{"schema":"dev.safa.cli/v1","command":"launcher","status":"user_action_required","request_id":null,"data":{"error":{"code":"runtime_missing","message":"The signed SAFA companion runtime has not been assembled in this development Skill.","retryable":false}},"warnings":[],"next_action":{"kind":"install_verified_runtime","safe_for_agent":false}}'
  exit 22
fi

for component in "$cli_path" "$broker_path" "$askpass_path"; do
  if ! /usr/bin/codesign --verify --strict "$component" >/dev/null 2>&1; then
    emit_error "runtime_signature_invalid" "A bundled SAFA runtime component failed code-signature verification." 45
  fi
done

exec "$cli_path" "$@"
